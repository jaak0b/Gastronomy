root = true

[*]
indent_style = space
end_of_line = lf
insert_final_newline = true
charset = utf-8-bom

[*.cs]
indent_size = 2
tab_width = 2
file_header_template = unset
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.CS8321.severity = error
dotnet_style_require_accessibility_modifiers = always:error
dotnet_remove_unnecessary_suppression_exclusions = none
dotnet_diagnostic.IDE0005.severity = error

max_line_length = 300
resharper_max_line_length = 300
resharper_wrap_lines = true
resharper_keep_existing_arrangement = false
resharper_keep_existing_linebreaks = false
resharper_csharp_keep_existing_declaration_parens_arrangement = false
resharper_csharp_keep_existing_invocation_parens_arrangement = false
resharper_csharp_keep_existing_expr_member_arrangement = false
resharper_csharp_wrap_parameters_style = chop_if_long
resharper_csharp_wrap_arguments_style = chop_if_long
resharper_csharp_wrap_chained_method_calls = chop_if_long
resharper_csharp_wrap_before_declaration_lpar = false
resharper_csharp_wrap_before_invocation_lpar = false
resharper_csharp_wrap_after_declaration_lpar = false
resharper_csharp_wrap_after_invocation_lpar = false
resharper_csharp_align_multiline_parameter = true
resharper_csharp_align_multiline_argument = true
resharper_csharp_align_multiline_calls_chain = true
resharper_csharp_align_multiline_expression = true
resharper_csharp_align_multiline_binary_expressions_chain = true
resharper_csharp_place_simple_initializer_on_single_line = true
resharper_csharp_wrap_object_and_collection_initializer_style = chop_if_long
resharper_csharp_blank_lines_after_control_transfer_statements = 0
resharper_csharp_keep_blank_lines_in_code = 1
resharper_csharp_keep_blank_lines_in_declarations = 1
resharper_csharp_remove_blank_lines_near_braces_in_code = true
resharper_csharp_remove_blank_lines_near_braces_in_declarations = true
resharper_csharp_continuous_indent_multiplier = 1
resharper_csharp_int_align = false
csharp_new_line_before_finally = true
csharp_new_line_before_catch = true
csharp_new_line_before_else = true
resharper_csharp_max_initializer_elements_on_line = 1
resharper_csharp_max_array_initializer_elements_on_line = 1
resharper_csharp_braces_for_ifelse = required_for_multiline
resharper_csharp_braces_redundant = true
resharper_csharp_place_simple_embedded_statement_on_same_line = never
resharper_csharp_align_first_arg_by_paren = true
resharper_csharp_align_linq_query = true
resharper_csharp_align_multiline_array_and_object_initializer = true
resharper_csharp_align_multiline_binary_patterns = true
resharper_csharp_align_multiline_extends_list = true
resharper_csharp_align_multiline_list_pattern = true
resharper_csharp_align_multiline_property_pattern = true
resharper_csharp_align_multiline_switch_expression = true
resharper_csharp_align_multiple_declaration = true
resharper_csharp_align_multline_type_parameter_constrains = true
resharper_csharp_align_multline_type_parameter_list = true
resharper_csharp_align_tuple_components = true
resharper_csharp_allow_far_alignment = true
resharper_csharp_blank_lines_around_single_line_auto_property = 1
resharper_csharp_blank_lines_around_single_line_invocable = 1
resharper_csharp_indent_anonymous_method_block = true
resharper_csharp_keep_existing_declaration_block_arrangement = true
resharper_csharp_keep_existing_embedded_block_arrangement = true
resharper_csharp_keep_existing_enum_arrangement = true
resharper_csharp_keep_existing_primary_constructor_declaration_parens_arrangement = true
resharper_csharp_outdent_binary_pattern_ops = true
resharper_csharp_outdent_commas = true
resharper_csharp_outdent_dots = true
resharper_csharp_place_accessorholder_attribute_on_same_line_ex = never
resharper_csharp_place_accessor_attribute_on_same_line_ex = never
resharper_csharp_place_expr_accessor_on_single_line = always
resharper_csharp_place_expr_method_on_single_line = always
resharper_csharp_place_expr_property_on_single_line = always
resharper_csharp_place_field_attribute_on_same_line_ex = never
resharper_csharp_place_record_field_attribute_on_same_line_ex = always
resharper_csharp_stick_comment = false
resharper_csharp_treat_case_statement_with_break_as_simple = false
resharper_csharp_wrap_after_primary_constructor_declaration_lpar = false
resharper_csharp_wrap_before_binary_opsign = true
resharper_csharp_wrap_before_eq = true
resharper_csharp_wrap_before_primary_constructor_declaration_lpar = false
resharper_csharp_wrap_chained_binary_expressions = chop_if_long
resharper_csharp_wrap_chained_binary_patterns = chop_if_long
resharper_csharp_wrap_extends_list_style = chop_if_long
resharper_csharp_wrap_multiple_type_parameer_constraints_style = chop_always
dotnet_style_prefer_collection_expression = false:none
dotnet_diagnostic.IDE0300.severity = none
dotnet_diagnostic.IDE0301.severity = none
dotnet_diagnostic.IDE0302.severity = none
dotnet_diagnostic.IDE0303.severity = none
dotnet_diagnostic.IDE0304.severity = none
dotnet_diagnostic.IDE0305.severity = none
resharper_use_collection_expression_highlighting = none
csharp_style_conditional_expression_over_assignment = false:none
csharp_style_conditional_expression_over_return = false:none
dotnet_diagnostic.IDE0045.severity = none
dotnet_diagnostic.IDE0046.severity = none

[*.{js,ts,vue,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[backend/GastronomyApp.Infrastructure/Migrations/*.cs]
generated_code = true
csharp_style_namespace_declarations = file_scoped:none
dotnet_diagnostic.IDE0005.severity = none
dotnet_diagnostic.IDE0161.severity = none
