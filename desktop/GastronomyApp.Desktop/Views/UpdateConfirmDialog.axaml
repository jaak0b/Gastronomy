<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GastronomyApp.Desktop.ViewModels"
        x:Class="GastronomyApp.Desktop.Views.UpdateConfirmDialog"
        x:DataType="vm:UpdateConfirmViewModel"
        TextOptions.TextRenderingMode="Antialias"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{Binding Title}">

    <StackPanel Margin="24" Spacing="18">
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
            <Button Name="CancelButton" Content="{Binding CancelLabel}" IsDefault="True" />
            <Button Name="ConfirmButton" Content="{Binding ConfirmLabel}" />
        </StackPanel>
    </StackPanel>

</Window>
