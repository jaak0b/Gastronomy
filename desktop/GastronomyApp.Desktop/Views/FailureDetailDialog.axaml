<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GastronomyApp.Desktop.ViewModels"
        xmlns:local="using:GastronomyApp.Desktop.Views"
        x:Class="GastronomyApp.Desktop.Views.FailureDetailDialog"
        x:DataType="vm:TechnicalDetailViewModel"
        Icon="/Assets/app.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="BorderOnly"
        TextOptions.TextRenderingMode="Antialias"
        Width="760"
        Height="480"
        MinWidth="480"
        MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

    <DockPanel>
        <local:DialogTitleBar DockPanel.Dock="Top" Text="{Binding Title}" />
        <DockPanel Margin="24">
            <Button Name="CloseButton"
                    DockPanel.Dock="Bottom"
                    Content="{Binding CloseLabel}"
                    Command="{Binding CloseCommand}"
                    IsDefault="True"
                    IsCancel="True"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0" />
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <SelectableTextBlock Text="{Binding Detail, FallbackValue=''}"
                                     FontFamily="Consolas, Menlo, monospace"
                                     FontSize="12" />
            </ScrollViewer>
        </DockPanel>
    </DockPanel>

</Window>
