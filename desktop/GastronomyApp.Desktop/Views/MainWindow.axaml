<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GastronomyApp.Desktop.ViewModels"
        xmlns:svc="using:GastronomyApp.Desktop.Services"
        x:Class="GastronomyApp.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="620"
        Height="520"
        Title="{Binding WindowTitle}">

    <ScrollViewer>
        <StackPanel Margin="28" Spacing="18">

            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      HorizontalAlignment="Right"
                      MinWidth="140"
                      ToolTip.Tip="{Binding LanguageLabel}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="svc:LanguageOption">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{Binding StatusText}" FontSize="18" />

            <TextBlock Text="{Binding AttentionText}" TextWrapping="Wrap" />

            <TextBlock Text="{Binding PhonesText}" TextWrapping="Wrap" />

            <Border IsVisible="{Binding HasNotice, FallbackValue=False}"
                    Padding="14"
                    CornerRadius="6"
                    Background="#EEF2F7">
                <TextBlock Text="{Binding NoticeText, FallbackValue=''}" TextWrapping="Wrap" />
            </Border>

            <Border IsVisible="{Binding HasError, FallbackValue=False}"
                    Padding="14"
                    CornerRadius="6"
                    Background="#FFF4E5">
                <TextBlock Text="{Binding ErrorMessage, FallbackValue=''}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="14">
                <Button Content="{Binding AdminButtonLabel}"
                        Command="{Binding OpenAdminPagesCommand}"
                        FontSize="18"
                        Padding="22,12" />
                <Button Content="{Binding SettingsButtonLabel}"
                        Command="{Binding OpenSettingsCommand}"
                        Padding="16,10" />
                <Button Content="{Binding QuitButtonLabel}"
                        Command="{Binding RequestQuitCommand}"
                        Padding="16,10" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</Window>
