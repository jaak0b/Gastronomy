<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GastronomyApp.Desktop.ViewModels"
        xmlns:svc="using:GastronomyApp.Desktop.Services"
        xmlns:conv="using:GastronomyApp.Desktop.Converters"
        x:Class="GastronomyApp.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        TextOptions.TextRenderingMode="Antialias"
        Width="460"
        Height="400"
        MinWidth="420"
        MinHeight="340"
        Title="{Binding WindowTitle}">

    <Window.Resources>
        <conv:StatusLevelConverter x:Key="StatusLevelIs" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.action">
            <Setter Property="Width" Value="250" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.action.accent">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="44" />
        </Style>

        <Style Selector="Border#StatusBar">
            <Setter Property="MinHeight" Value="8" />
            <Setter Property="Background" Value="{DynamicResource StatusStartingBrush}" />
        </Style>
        <Style Selector="Border#StatusBar.running">
            <Setter Property="Background" Value="{DynamicResource StatusRunningBrush}" />
        </Style>
        <Style Selector="Border#StatusBar.warning">
            <Setter Property="Background" Value="{DynamicResource StatusWarningBrush}" />
        </Style>
        <Style Selector="Border#StatusBar.down">
            <Setter Property="Background" Value="{DynamicResource StatusDownBrush}" />
        </Style>
        <Style Selector="Border#StatusBar.withText">
            <Setter Property="Padding" Value="20,12" />
        </Style>

        <Style Selector="Button#CheckForUpdates">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button#CheckForUpdates:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="Ellipse#UpdateSpinner">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding WindowTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <TextBlock Name="VersionText"
                               Text="{Binding VersionText, FallbackValue=''}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LanguageLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}"
                              MinWidth="120"
                              VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="svc:LanguageOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Name="CheckForUpdates"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsVisible="{Binding CanCheckForUpdates, FallbackValue=False}"
                            VerticalAlignment="Center">
                        <Panel>
                            <Path Name="UpdateDownloadArrow"
                                  Data="M5,20h14v-2H5V20z M19,9h-4V3H9v6H5l7,7 7,-7z"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Stretch="Uniform"
                                  Width="14"
                                  Height="14"
                                  IsVisible="{Binding !IsUpdateCheckRunning, FallbackValue=False}" />
                            <Ellipse Name="UpdateSpinner"
                                     Width="14"
                                     Height="14"
                                     Stroke="{DynamicResource TextSecondaryBrush}"
                                     StrokeThickness="2"
                                     StrokeDashArray="2,3"
                                     RenderTransformOrigin="50%,50%"
                                     IsVisible="{Binding IsUpdateCheckRunning, FallbackValue=False}">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Name="StatusBar"
                DockPanel.Dock="Bottom"
                Classes.running="{Binding CurrentStatus, Converter={StaticResource StatusLevelIs}, ConverterParameter=Running, FallbackValue=False}"
                Classes.warning="{Binding CurrentStatus, Converter={StaticResource StatusLevelIs}, ConverterParameter=Warning, FallbackValue=False}"
                Classes.down="{Binding CurrentStatus, Converter={StaticResource StatusLevelIs}, ConverterParameter=Down, FallbackValue=False}"
                Classes.withText="{Binding HasStatusText, FallbackValue=False}">
            <StackPanel Spacing="10">
                <TextBlock Name="StatusMessage"
                           Text="{Binding StatusText, FallbackValue=''}"
                           IsVisible="{Binding HasStatusText, FallbackValue=False}"
                           Foreground="{DynamicResource StatusForegroundBrush}"
                           TextWrapping="Wrap" />
                <Button Name="ShowFailureDetail"
                        Content="{Binding FailureDetailButtonLabel}"
                        Command="{Binding ShowFailureDetailCommand}"
                        IsVisible="{Binding CanShowFailureDetail, FallbackValue=False}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="Actions" Margin="20,14" VerticalAlignment="Center">
                <Button Content="{Binding AdminButtonLabel}"
                        Command="{Binding OpenAdminPagesCommand}"
                        Classes="action accent" />

                <StackPanel Spacing="8" Margin="0,20,0,0">
                    <Button Content="{Binding DataFolderButtonLabel}"
                            Command="{Binding OpenDataFolderCommand}"
                            Classes="action" />
                    <Button Content="{Binding RepairButtonLabel}"
                            Command="{Binding RepairSetupCommand}"
                            Classes="action" />
                </StackPanel>

                <Button Content="{Binding QuitButtonLabel}"
                        Command="{Binding RequestQuitCommand}"
                        Classes="action"
                        Margin="0,24,0,0" />
            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</Window>
