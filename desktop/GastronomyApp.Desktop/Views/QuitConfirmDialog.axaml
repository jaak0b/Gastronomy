<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GastronomyApp.Desktop.ViewModels"
        xmlns:local="using:GastronomyApp.Desktop.Views"
        x:Class="GastronomyApp.Desktop.Views.QuitConfirmDialog"
        x:DataType="vm:QuitConfirmViewModel"
        Icon="/Assets/app.ico"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="BorderOnly"
        TextOptions.TextRenderingMode="Antialias"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{Binding Title}">

    <DockPanel>
        <local:DialogTitleBar DockPanel.Dock="Top" Text="{Binding Title}" />
        <StackPanel Margin="24" Spacing="18">
            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <Button Name="CancelButton" Content="{Binding CancelLabel}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
                <Button Name="ConfirmButton" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" Classes="danger" />
            </StackPanel>
        </StackPanel>
    </DockPanel>

</Window>
