<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GastronomyApp.Desktop.App"
             xmlns:local="using:GastronomyApp.Desktop"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://GastronomyApp.Desktop/Themes/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="SystemAccentColor">#2F6FDB</Color>
            <Color x:Key="SystemAccentColorLight1">#2F6FDB</Color>
            <Color x:Key="SystemAccentColorLight2">#2F6FDB</Color>
            <Color x:Key="SystemAccentColorLight3">#2F6FDB</Color>
            <Color x:Key="SystemAccentColorDark1">#2F6FDB</Color>
            <Color x:Key="SystemAccentColorDark2">#2F6FDB</Color>
            <Color x:Key="SystemAccentColorDark3">#2F6FDB</Color>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://GastronomyApp.Desktop/Themes/Skin.axaml" />
    </Application.Styles>
</Application>
